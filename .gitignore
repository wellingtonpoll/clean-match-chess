# Frontend Playwright (feature 006)
apps/frontend/playwright-report/
apps/frontend/test-results/
apps/frontend/tests/e2e/__layout_audit__/

# Lichess month-export dumps (used locally to build baselines — too large for git)
lichess_db_standard_rated_*.pgn.zst

# Environment files (feature 008 / 009+). Never commit real credentials.
# `.env.example` IS committed as the template; concrete .env is not.
.env
.env.local
.env.*.local

# Phase-1 sampling checkpoints from feature 007 build pass (legacy pickle path)
/tmp/baselines-007/

# Feature 013 — engine-assisted corpus crawled from chess.com banned accounts.
# PGNs contain third-party opponent usernames; kept local-only to avoid
# creating a searchable "suspected cheaters + their opponents" artifact.
tests/fixtures/corpora/engine_assisted/*.pgn
tests/fixtures/corpora/engine_assisted/*.provenance.json
