# Clean Match Chess — environment template.
#
# Copy to .env at repo root:
#   cp .env.example .env
#
# The .env file is gitignored. Override these in your deployment
# environment for production — never commit production secrets.

# ── Postgres (feature 008: analysis cache) ────────────────────────────

POSTGRES_USER=cleanmatch
POSTGRES_PASSWORD=cleanmatch
POSTGRES_DB=cleanmatch
POSTGRES_PORT=5432

# SQLAlchemy connection URI consumed by `analysis_core.db.session`.
# Driver prefix `postgresql+psycopg://` selects psycopg 3 (async).
DATABASE_URL=postgresql+psycopg://cleanmatch:cleanmatch@localhost:5432/cleanmatch
