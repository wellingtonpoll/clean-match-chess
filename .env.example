# Clean Match Chess — environment template.
#
# Copy to .env at repo root:
#   cp .env.example .env
#
# The .env file is gitignored. Override these in your deployment
# environment for production — never commit production secrets.

# ── Postgres (feature 008: analysis cache) ────────────────────────────

POSTGRES_USER=cleanmatch
POSTGRES_PASSWORD=cleanmatch
POSTGRES_DB=cleanmatch
POSTGRES_PORT=5432

# SQLAlchemy connection URI consumed by `analysis_core.db.session`.
# Driver prefix `postgresql+psycopg://` selects psycopg 3 (async).
DATABASE_URL=postgresql+psycopg://cleanmatch:cleanmatch@localhost:5432/cleanmatch

# ── Stockfish engine (feature 009: explicit engine resolution) ────────
#
# The audit pipeline (`pipeline.run.run_single_game`) silently falls back
# to a deterministic `StaticAnalyzer` when no engine is configured, which
# collapses every game's suspicion score to a fixed ~0.316. The frontend
# script (`apps/frontend/lib/analyze.py`) refuses to run unless ONE of the
# variables below is set, so users see an explicit error instead of garbage
# scores. Pick exactly one:
#
#   CLEANMATCH_ENGINE_PATH=/usr/bin/stockfish
#   CLEANMATCH_ENGINE_IMAGE=cleanmatch-stockfish:sf16
CLEANMATCH_ENGINE_IMAGE=cleanmatch-stockfish:sf16
